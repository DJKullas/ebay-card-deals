# Copy to .env for local runs. In GitHub Actions these come from repository secrets.

# --- eBay data (required) ---
# RapidAPI key for https://rapidapi.com/mahmudulhasandev/api/real-time-ebay-data
RAPIDAPI_KEY=

# --- Price guide (recommended) ---
# PriceCharting "Legendary" API token (40 chars). The same token is used for
# pricecharting.com (Pokemon/TCG) and sportscardspro.com (sports cards).
# If left blank the PriceCharting provider is skipped and only the eBay
# active-listing fallback is used for pricing.
PRICECHARTING_TOKEN=
# Optional: separate token for sportscardspro.com if your subscription differs.
SPORTSCARDSPRO_TOKEN=

# --- PSA cert verification (optional) ---
# Free token from https://www.psacard.com/publicapi (100 calls/day).
PSA_API_TOKEN=

# --- Email (required unless you only use Discord) ---
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (default), 465 = implicit TLS. SMTP_SECURE is inferred from the port unless set.
SMTP_PORT=587
SMTP_USER=you@gmail.com
# For Gmail use an App Password: https://myaccount.google.com/apppasswords (spaces are fine)
SMTP_PASS=
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# --- Discord (optional) ---
DISCORD_WEBHOOK_URL=

# --- Misc ---
# Set to 1 to log every listing evaluated (verbose)
DEBUG=
